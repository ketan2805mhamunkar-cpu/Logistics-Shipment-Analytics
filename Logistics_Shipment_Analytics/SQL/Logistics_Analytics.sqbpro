index="25" value="88"/><column index="26" value="158"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- Verify total shipments and shipping cost


SELECT
    COUNT(*) AS Total_Shipments,
    ROUND(SUM(Shipping_Cost_INR), 2) AS Total_Shipping_Cost_INR,
    ROUND(AVG(Shipping_Cost_INR), 2) AS Average_Shipping_Cost_INR
FROM Logistics_Final_Data;


-- Analyze shipping cost by carrier


SELECT
    Carrier,
    COUNT(*) AS Total_Shipments,
    ROUND(AVG(Shipping_Cost_INR), 2) AS Average_Shipping_Cost_INR,
    ROUND(SUM(Shipping_Cost_INR), 2) AS Total_Shipping_Cost_INR
FROM Logistics_Final_Data
WHERE Carrier IS NOT NULL
GROUP BY Carrier
ORDER BY Average_Shipping_Cost_INR DESC;



-- Check delivery performance by status


SELECT
    Delivery_Status,
    COUNT(*) AS Shipment_Count,
    ROUND(
        COUNT(*) * 100.0 /
        (SELECT COUNT(*) FROM Logistics_Final_Data), 2
    ) AS Percentage
FROM Logistics_Final_Data
GROUP BY Delivery_Status
ORDER BY Shipment_Count DESC;


-- Identify delayed shipments


SELECT
    Shipment_ID,
    Carrier,
    Origin_City,
    Destination_City,
    Dispatch_Days,
    Delivery_Days,
    Shipping_Cost_INR
FROM Logistics_Final_Data
WHERE Delivery_Days &gt; 7
ORDER BY Delivery_Days DESC
LIMIT 20;



-- Delivery status breakdown









</sql><sql name="SQL 2">-- Delivery status breakdown

SELECT
    Delivery_Status,
    COUNT(*) AS Shipment_Count,
    ROUND(
        COUNT(*) * 100.0 /
        (SELECT COUNT(*) FROM Logistics_Final_Data),
        2
    ) AS Percentage
FROM Logistics_Final_Data
GROUP BY Delivery_Status
ORDER BY Shipment_Count DESC;

-- Delayed shipments — more than 7 days

SELECT
    Shipment_ID,
    Carrier,
    Origin_City,
    Destination_City,
    Delivery_Days,
    Shipping_Cost_INR
FROM Logistics_Final_Data
WHERE Delivery_Days &gt; 7
ORDER BY Delivery_Days DESC
LIMIT 20;


-- Regional shipping cost comparison


SELECT
    Region,
    COUNT(*) AS Total_Shipments,
    ROUND(SUM(Shipping_Cost_INR), 2) AS Total_Shipping_Cost,
    ROUND(AVG(Shipping_Cost_INR), 2) AS Average_Shipping_Cost
FROM Logistics_Final_Data
GROUP BY Region
ORDER BY Total_Shipping_Cost DESC;


-- Top 10 destinations by shipment volume


SELECT
    Destination_City,
    COUNT(*) AS Total_Shipments,
    ROUND(AVG(Shipping_Cost_INR), 2) AS Average_Shipping_Cost
FROM Logistics_Final_Data
WHERE Destination_City IS NOT NULL
GROUP BY Destination_City
ORDER BY Total_Shipments DESC
LIMIT 10;


-- Monthly shipment trends


SELECT
    strftime('%Y-%m', Order_Date) AS Order_Month,
    COUNT(*) AS Total_Shipments,
    ROUND(SUM(Shipping_Cost_INR), 2) AS Total_Shipping_Cost
FROM Logistics_Final_Data
WHERE Order_Date IS NOT NULL
GROUP BY strftime('%Y-%m', Order_Date)
ORDER BY Order_Month;

-- Compare the SQL results with your Power BI cards:


SELECT
    COUNT(*) AS Total_Rows,
    COUNT(DISTINCT Shipment_ID) AS Unique_Shipments,
    ROUND(SUM(Shipping_Cost_INR), 2) AS Total_Shipping_Cost,
    ROUND(AVG(Shipping_Cost_INR), 2) AS Average_Shipping_Cost,
    ROUND(SUM(Total_Transport_Cost_INR), 2) AS Total_Transport_Cost,
    ROUND(AVG(Delivery_Days), 2) AS Average_Delivery_Days
FROM Logistics_Final_Data;
</sql><current_tab id="1"/></tab_sql></sqlb_project>
